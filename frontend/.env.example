# Frontend Aura Clinic — copie para .env e ajuste os valores. NÃO commite o .env.
# URL base da API do backend, usada só em desenvolvimento (vite dev).
# O build de produção ignora esta variável e chama sempre /api no mesmo domínio.
VITE_API_URL=http://localhost:4000/api

# Destino do proxy do Vite para /api e /uploads em desenvolvimento.
# VITE_DEV_API_TARGET=http://localhost:4000
