# Backend Aura Clinic — copie para .env e ajuste os valores. NÃO commite o .env.
NODE_ENV=development
RUN_DATABASE_MIGRATIONS=false
# Break-glass legado; nunca habilite no deploy normal.
ALLOW_GLOBAL_MIGRATIONS=false
ALLOW_LEGACY_GLOBAL_BOOTSTRAP=false
PORT=4000
# Local fica restrito à própria máquina; containers de produção usam 0.0.0.0.
# API_BIND_HOST=127.0.0.1

# Banco de dados Postgres (obrigatório)
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/aura_clinic
DATABASE_SSL=false
# Em produção: DATABASE_SSL=true e validação do certificado obrigatória.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# CA em PEM; em secrets, quebras de linha também podem ser escritas como \n.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_POOL_MAX=10

# Segredo dos tokens (obrigatório em produção). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-valor-forte

# Origem permitida do frontend (CORS)
# Obrigatória em produção. Use origens exatas separadas por vírgula; nunca "*".
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Quantidade exata de proxies confiáveis até o Node (Cloudflare + nginx = 2).
# Ajuste à topologia real para impedir spoofing de IP e preservar o rate limit.
# TRUST_PROXY_HOPS=2

# Somente a suíte automatizada usa esta válvula para simular NODE_ENV=production.
# Nunca configure no servidor real.
# ALLOW_INSECURE_TEST_ENV=false

# Opcional em desenvolvimento descartável: ignora login apenas em localhost.
# Mantenha false para testar o mesmo fluxo de autenticação usado em produção.
# É proibida quando NODE_ENV=production.
# ALLOW_LOCAL_AUTH_BYPASS=false

# Libera o endpoint destrutivo POST /api/admin/reset-demo-data em produção.
# Por padrão o reset fica BLOQUEADO quando NODE_ENV=production (retorna 403).
# Defina como "true" apenas quando realmente quiser permitir o reset em produção.
# ALLOW_DEMO_RESET=true

# ---------- Multi-tenant (SaaS) ----------
# Cada clínica (tenant) vive num schema Postgres próprio ("tenant_<id>").
# O tenant da requisição é resolvido por: token → header X-Tenant → DEFAULT_TENANT.

# Clínica padrão quando a requisição não traz X-Tenant nem token.
# Útil em dev local (ex.: aura). Em PRODUÇÃO defina apenas se fizer sentido
# (ex.: instância dedicada a uma clínica); caso contrário, deixe indefinida
# para exigir o header X-Tenant explicitamente.
# DEFAULT_TENANT=aura

# Superadmin inicial do painel de plataforma. Semeado no primeiro boot SOMENTE
# se a tabela platform.platform_users estiver vazia.
# Em PRODUÇÃO estas envs são OBRIGATÓRIAS para semear (sem elas o boot apenas
# avisa e NÃO cria credenciais padrão). Use e-mail real e senha forte.
# PLATFORM_ADMIN_EMAIL=superadmin@suaempresa.com
# PLATFORM_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Cadastro público de clínicas em POST /api/signup.
# "false" desabilita (o painel de plataforma continua podendo criar clínicas).
# Qualquer outro valor (ou ausente) mantém o signup público habilitado.
# Defina conforme a estratégia de vendas: aberto (true) ou só via plataforma (false).
# ALLOW_PUBLIC_SIGNUP=true

# ---------- Asaas (gateway de pagamento) ----------
# Existem DOIS níveis de credencial, e eles não se misturam:
#
#   PLATAFORMA  a conta da Monitence, que cobra a assinatura das clínicas.
#               Configurada AQUI, só pelo ambiente — nunca vem do banco, para
#               que nenhuma clínica possa influenciar a conta que recebe.
#   CLÍNICA     cada clínica cadastra a PRÓPRIA chave na tela de Integrações
#               para cobrar o cliente final (sinal, venda de joias). Fica
#               cifrada no cofre `tenant_integrations`, no schema dela.
#
# O dinheiro sempre cai na conta de quem cobrou — sem split, sem subconta.

# Ambiente do gateway. São DUAS contas diferentes, com chaves diferentes:
#   Sandbox   https://api-sandbox.asaas.com/v3   (cobra de mentira)
#   PRODUÇÃO  https://api.asaas.com/v3           (dinheiro de verdade)
# Em produção esta URL é OBRIGATÓRIA: o default do código é o sandbox, e subir
# a produção apontando para ele faz o cliente pagar um boleto que não existe.
# O boot avisa alto quando NODE_ENV=production e a URL contém "sandbox".
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Chave da API da conta da Monitence (painel do Asaas > Integrações > API).
ASAAS_API_KEY=

# Token do webhook da plataforma. OBRIGATÓRIO junto da chave: sem ele o
# endpoint público /api/webhooks/asaas ficaria aberto e qualquer POST marcaria
# assinatura como paga. Gere um valor forte e cadastre O MESMO no painel do
# Asaas (Integrações > Webhooks > "Token de autenticação"):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ASAAS_WEBHOOK_TOKEN=

# Chave que cifra as credenciais das clínicas no cofre (AES-256-GCM).
# RECOMENDADO definir: sem ela o cofre deriva do AUTH_SECRET, e aí trocar o
# AUTH_SECRET obriga TODAS as clínicas a recadastrarem a chave do Asaas.
# Gere com o mesmo comando acima.
ASAAS_VAULT_KEY=

# Timeout das chamadas ao gateway, em ms.
# ASAAS_TIMEOUT_MS=20000

# URL pública da API — usada para MOSTRAR à clínica qual endereço ela deve
# cadastrar como webhook no painel do Asaas dela:
#   <PUBLIC_API_URL>/api/webhooks/asaas/<slug-da-clinica>
# Sem isso a tela de Integrações não tem como dizer o que colar.
PUBLIC_API_URL=http://localhost:4000

# ---------- E-mail transacional (Resend) ----------
# Integração oficial da plataforma para mensagens automáticas. Configure as
# DUAS variáveis no secret do deploy; sem ambas a fila fica em modo assistido e
# não consome créditos de e-mail.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="Aura Clinic <avisos@seudominio.com>"
# EMAIL_TIMEOUT_MS=15000

# ---------- Conciliação periódica com o Asaas ----------
# Worker que relê no gateway as cobranças ainda em aberto (faturas da plataforma
# e intents das clínicas) e aplica o efeito do webhook que se perdeu. É rede de
# segurança: quem confirma pagamento no caminho normal é o WEBHOOK.
#
# DESLIGADO por padrão, inclusive em produção — a ativação é sempre explícita.
# Não está amarrado ao NODE_ENV de propósito: a suíte de testes sobe o servidor
# com NODE_ENV=production, e o worker acabaria batendo no gateway a cada
# `npm test`, gastando chamada com a credencial do .env do desenvolvedor.
# ASAAS_RECONCILE_ENABLED=true

# Intervalo entre rodadas, em minutos (default 15). Valores baixos gastam
# chamada de API sem ganho: o webhook já cobre o caminho normal.
# ASAAS_RECONCILE_INTERVAL_MIN=15

# Máximo de itens por rodada, POR LADO (plataforma e clínicas). Segura a rajada
# de chamadas ao gateway; o excedente vai para a rodada seguinte e é logado.
# ASAAS_RECONCILE_BATCH=50

# ---------- Cloudflare R2 (armazenamento de arquivos) ----------
# Substitui o disco local do container, onde hoje TODOS os tenants gravam no
# mesmo diretório (ver docs/PENDENCIAS.md, item 7). No R2 cada arquivo vive sob
# um prefixo da clínica, e o disco do servidor deixa de ser o limite.
#
# Com TODAS as variáveis abaixo vazias o sistema continua no disco local apenas
# em desenvolvimento. Em produção, as seis são obrigatórias.
#
# Nomear um bucket (R2_BUCKET_PUBLIC ou R2_BUCKET_PRIVATE) é a declaração de
# intenção de usar o R2, e a partir daí o conjunto é INDIVISÍVEL: as seis. Meia
# configuração grava arquivo que ninguém consegue ler depois e derruba o boot.
#
# Onde pegar: painel da Cloudflare > R2 > "Manage R2 API Tokens".

# Endpoint S3 da sua conta R2 (o <account_id> aparece no painel).
# Formato: https://<account_id>.r2.cloudflarestorage.com
# Sem ele o cliente S3 não sabe para onde falar e todo upload cai no disco local.
R2_ENDPOINT=

# Par de credenciais do token de API do R2. É o segredo desta seção: quem o tem
# lê e apaga os comprovantes e termos assinados de TODAS as clínicas. Nunca
# commite — em produção ele chega pelo secret do GitHub Actions.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket dos arquivos servidos direto ao navegador (fotos de joias, logo da
# clínica). Faltando, as imagens do catálogo somem.
R2_BUCKET_PUBLIC=

# Bucket dos arquivos SENSÍVEIS (comprovante de pagamento, PDF de termo
# assinado). Este bucket NÃO pode ter acesso público: o download passa pela API,
# que confere sessão e tenant e assina uma URL temporária. Apontar os dois para
# o mesmo bucket exporia documento de cliente na internet aberta.
R2_BUCKET_PRIVATE=

# Domínio público na frente do bucket público — o subdomínio r2.dev dele ou um
# domínio próprio (CDN). É o prefixo das URLs que vão no HTML: sem ele as
# imagens são gravadas mas o frontend não tem como montar o endereço.
# Formato: https://cdn.seu-dominio.com   (SEM barra no final)
R2_PUBLIC_BASE_URL=
